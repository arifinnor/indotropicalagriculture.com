# Google Analytics 4
# Get your Measurement ID from: https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification
# Get your verification code from: https://search.google.com/search-console → Add Property
GOOGLE_SITE_VERIFICATION=YOUR_VERIFICATION_CODE

# Resend (contact form email delivery)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXX
# Recipient of contact form submissions
RESEND_TO_EMAIL=exports@yourdomain.com
# Sender address — must use a verified domain (resend.com/domains) in production
# Use onboarding@resend.dev for testing without a verified domain
RESEND_FROM_EMAIL=Your Company <noreply@yourdomain.com>
